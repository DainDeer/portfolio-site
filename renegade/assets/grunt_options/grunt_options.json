  "composer": {
    "reference": "assets/src/grunt_gear.py layers(loadout, look, step): the loadout composer used for every sprite here",
    "steps": [
      "armVariant = gear.weapon[loadout.weapon].armVariant, or one_hand when the weapon slot is empty",
      "for each layer in layerOrder: skip reserved layers (stowed, offhand); a two_hand weapon also blocks offhand (blocksOffhand), so the offhand stays empty",
      "arms -> sharedBase.arms[armVariant] for the look's skin; sleeves -> gear.body[id].layers.sleeves[armVariant] (or the empty_body sleeves for that variant)",
      "every other layer has one file; take the frame (stand | walkA | walkB) column from the 3-frame strips",
      "hides_hair / hides_facial_hair / hides_legwear drop those layers; composite bottom -> top"
    ]
  },
