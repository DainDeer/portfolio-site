  "layerRoles": {
    "cosmetic": [
      "body",
      "underwear",
      "face",
      "arms",
      "hair",
      "facial_hair"
    ],
    "slots": {
      "head": [
        "headwear"
      ],
      "body": [
        "legwear",
        "footwear",
        "torso",
        "belt",
        "sleeves"
      ],
      "backpack": [
        "pack_back",
        "pack_straps"
      ],
      "weapon": [
        "weapon"
      ],
      "offhand": [
        "shield"
      ]
    },
    "reserved": {
      "offhand": "RESERVED, not drawn: dual wield / shields, in handR (one_hand weapons are in handL). Drawn right after weapon, under arms (the hand closes over its grip). Blocked by any two_hand weapon (blocksOffhand).",
      "stowed": "RESERVED, not drawn: the backup weapon set slung on the back. Drawn right after pack_back and before body: in front of a pack, behind the Grunt, so a long gun pokes out over a shoulder / below the hip. Belt-carried backups (holster, sheath) would need a second spot after belt; left for later."
    },
    "why": {
      "pack_back first": "the pack is behind everything, so only its edges show past the arms/torso and above the shoulders (bedroll ends either side of the head)",
      "pack_straps after torso, before belt": "straps sit on the outfit; the belt and scarf ends go over their bottom ends; sleeves/arms still cover the shoulders",
      "weapon before arms": "the hand (arms layer) closes over the grip",
      "headwear last": "over hair; hair above the hat top edge is clipped per column (clipsHairAbove)",
      "shield after sleeves": "a shield is braced in FRONT of its arm (the reserved offhand layer sits under arms, for a dual-wield grip the hand closes over), so shields get their own layer over sleeves; it stays below the chin (top edge y >= 13.5), so hair / beard / headwear above it never overlap it"
    },
    "noOutline": [
      "face",
      "pack_straps"
    ]
  },
  "slotMapping": {
    "source": "data/items.js slots weapon | head | body | backpack; data/config.js grunts.slots {weapon: [weapon], gear: [head, body, backpack]}",
    "head": "headwear layer. hides_hair -> skip the hair layer (hoods, full helmets). hides_facial_hair reserved for full masks (horse mask).",
    "body": "ONE outfit set filling torso + sleeves + belt + legwear + footwear. No standalone leg/foot gear. hides_legwear (robes, dresses) -> skip legwear.",
    "backpack": "pack_back + pack_straps",
    "weapon": "weapon (active main set), with pose one_hand (handL) | two_hand (both hands, blocksOffhand). offhand/stowed reserved; the belt holster spot comes later.",
    "emptySlot": {
      "head": "nothing drawn (hair shows)",
      "body": "mannequin undershirt + shorts, barefoot (gear/empty_body/)",
      "backpack": "nothing drawn",
      "weapon": "nothing drawn (bare hands = nat_fists)"
    }
  },
  "poses": {
    "rule": "weapon.pose is one_hand | two_hand. weapon.armVariant (one_hand | two_hand | two_hand_rifle) picks the arms + sleeves files (empty weapon slot = one_hand). A two_hand weapon blocksOffhand: the offhand layer is not drawn and nothing can be equipped there.",
